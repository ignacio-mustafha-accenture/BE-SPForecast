# syntax=docker/dockerfile:1
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN pip install --no-cache-dir --progress-bar off \
        asyncpg==0.31.0 \
        python-dotenv==1.2.3

COPY migrate_schema.py migrate_data.py create_daily_hours.py fix_sequences.py ./
COPY schema_auth.sql schema_clients.sql schema_holidays.sql ./

CMD ["python", "migrate_schema.py"]
